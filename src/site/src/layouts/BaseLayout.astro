---
import "../styles/global.css";
import { LOCALES, localePath, withBase, type Locale } from "../utils/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const site = Astro.site ?? new URL("http://localhost");
const absolute = (path: string) => new URL(path, site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={absolute(localePath(locale))} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(localePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(localePath("en"))} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "cs" ? "cs_CZ" : "en_US"} />
    <script
      defer
      src="https://analytics.bohunky.xyz/script.js"
      data-website-id="943275c9-1dd9-4c8b-bd45-f5808fa556fd"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
