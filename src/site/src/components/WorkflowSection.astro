---
import SectionHeader from "./SectionHeader.astro";
import type { Messages } from "../i18n/en";

interface Props {
  t: Messages["workflow"];
}

const { t } = Astro.props;
---

<section class="section" aria-labelledby="workflow-title">
  <div id="workflow-title">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} />
  </div>
  <ol class="grid">
    {
      t.steps.map((step, i) => (
        <li class="card">
          <span class="number" aria-hidden="true">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <code class:list={[step.tagTone]}>{step.tag}</code>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section {
    max-width: 72rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .number {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary-deep);
    font-weight: 700;
    color: #fff;
  }
  h3 {
    margin-top: 4px;
    font-size: 1.1rem;
    font-weight: 600;
  }
  p {
    flex: 1;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  code {
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--surface-subdued);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #475569;
  }
  code.success {
    background: var(--success-bg);
    color: var(--success-text);
  }
</style>
