---
export type IconName =
  | "brain"
  | "clock"
  | "nodes"
  | "gauge"
  | "shield"
  | "terminal"
  | "github"
  | "docker"
  | "check"
  | "spark"
  | "logo";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;

const strokes: Partial<Record<IconName, string>> = {
  brain:
    "M9 4a3 3 0 0 0-3 3v.5A3.5 3.5 0 0 0 4 11a3.5 3.5 0 0 0 2 3.2V15a3 3 0 0 0 3 3h.5V4H9Zm6 0a3 3 0 0 1 3 3v.5a3.5 3.5 0 0 1 2 3.5 3.5 3.5 0 0 1-2 3.2V15a3 3 0 0 1-3 3h-.5V4H15Z",
  clock: "M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z",
  nodes:
    "M12 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-6 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 9v3m0 0-5 3m5-3 5 3",
  gauge: "M4 17a8 8 0 1 1 16 0M12 17l4-5",
  shield: "M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Zm-3 9 2 2 4-4",
  terminal: "m5 8 4 4-4 4m7 0h7M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z",
  check: "m5 12 5 5 9-10",
  spark: "M12 3v4m0 10v4M3 12h4m10 0h4m-3.5-6.5-3 3m-3 3-3 3m9 0-3-3m-3-3-3-3",
};
const stroke = strokes[name];
---

{
  name === "logo" ? (
    <svg width={size} height={size} viewBox="0 0 512 512" aria-hidden="true">
      <defs>
        <linearGradient id="logo-bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#6366f1" />
          <stop offset="1" stop-color="#4f46e5" />
        </linearGradient>
      </defs>
      <rect width="512" height="512" rx="112" fill="url(#logo-bg)" />
      <rect x="96" y="132" width="320" height="248" rx="40" fill="#fff" />
      <path d="M168 380v60l84-60z" fill="#fff" />
      <rect x="140" y="228" width="232" height="28" rx="14" fill="#4f46e5" />
      <rect x="180" y="286" width="152" height="28" rx="14" fill="#7c3aed" />
    </svg>
  ) : name === "github" ? (
    <svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" />
    </svg>
  ) : name === "docker" ? (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 12h15.5c1 0 1.9-.4 2.5-1.2-1-.3-1.5-1-1.6-2-1.2.5-2 .2-2.5-.6M3 12c0 4 3 7 8 7 5 0 8-3 8-7M6 12V9h3v3m0-3V6h3v3m0 0h3v3" />
    </svg>
  ) : (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={stroke} />
    </svg>
  )
}
